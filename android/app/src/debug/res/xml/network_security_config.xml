<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  A development backend is served over plain HTTP on a workstation, and
  Android has blocked cleartext by default since API 28 - so without this a
  debug build on a real device fails every request before it leaves the phone.

  This file lives in `src/debug/`, so it is merged into debug builds and into
  nothing else: a release build keeps the platform default, where cleartext is
  refused. The hosts are named rather than opened wholesale, so even a debug
  build will not talk plaintext to production.

  `localhost` is what `adb reverse tcp:4040 tcp:4040` makes the host's backend
  reachable as; the private ranges cover a LAN address when the phone and the
  workstation share Wi-Fi instead.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.168</domain>
    </domain-config>
</network-security-config>
