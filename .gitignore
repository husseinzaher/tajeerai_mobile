# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# pubspec.lock IS committed. This is an application, not a package: pinning the
# resolved versions is what makes a CI build reproduce a local one.

# Generated sources.
#
# Regenerated by `dart run build_runner build`, which CI runs from a clean
# checkout -- so a stale committed artifact cannot hide a broken generator.
*.g.dart
*.freezed.dart

# Local build configuration. The per-environment files (.env.development,
# .env.staging, .env.production) ARE committed -- they hold hostnames, not
# secrets. `.env` is the developer's own override and is not.
.env

# Coverage
coverage/

