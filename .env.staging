# Staging.
#
#     flutter run --dart-define-from-file=.env.staging
#
# One host serves both the API and the socket here, unlike production where
# they are split across api./socket.tajeerai.com. Nothing in the client cares:
# the two origins are configured independently, so they are free to be equal.
TAJEER_ENV=staging
TAJEER_API_URL=https://api.tajeerai.com
TAJEER_SOCKET_URL=https://socket.tajeerai.com
