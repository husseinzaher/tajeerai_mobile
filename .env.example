# Tajeer AI mobile -- build configuration.
#
# Copy to `.env` and edit for your machine:
#
#     cp .env.example .env
#     flutter run --dart-define-from-file=.env
#
# The per-environment files (.env.development, .env.staging, .env.production)
# are committed and hold the real hostnames. `.env` is yours, is gitignored,
# and overrides them for local work.
#
# ── SECURITY ──────────────────────────────────────────────────────────────
# These values are compiled into the binary and can be read back out of a
# shipped APK or IPA. They are hostnames and feature flags, nothing more.
# NEVER put an API key, a secret, or a credential in one of these files.
# Secrets belong on the server, or in the device Keychain at runtime.
# ──────────────────────────────────────────────────────────────────────────

# Which deployment this build points at: development | staging | production
TAJEER_ENV=development

# HTTP API origin. Routes are versioned under /v1.
#
# 10.0.2.2 is the host machine as seen from the Android emulator. A PHYSICAL
# DEVICE cannot reach 10.0.2.2 -- it needs your machine's LAN address, e.g.
# http://100.1.1.107:4040. Copy this file to `.env` and set it there.
#
# Port 4040 is where docker-compose publishes the backend (container :4000).
TAJEER_API_URL=http://10.0.2.2:4040

# Socket.IO origin.
#
# A separate host from the API in staging and production. Locally one Nest
# process serves both, so this is usually the same value as TAJEER_API_URL.
TAJEER_SOCKET_URL=http://10.0.2.2:4040

# Google Sign-In — native OAuth client ids from Google Cloud Console. Public,
# not secrets — they only identify the app to Google. The web client id the
# API verifies id tokens against is configured in the platform back office.
#
# Android: OAuth client type "Android", package com.tajeerai.mobile, SHA-1 from
# `make google-android-sha1`.
# TAJEER_GOOGLE_ANDROID_CLIENT_ID=123456789-android.apps.googleusercontent.com
#
# iOS: OAuth client type "iOS", bundle id com.tajeerai.mobile, then run
# `make google-sign-in-setup`.
# TAJEER_GOOGLE_IOS_CLIENT_ID=123456789-ios.apps.googleusercontent.com
