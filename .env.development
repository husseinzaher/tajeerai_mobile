# Local development against a backend on this machine.
#
#     flutter run --dart-define-from-file=.env.development
#
# 10.0.2.2 is the host machine as seen from the Android emulator. On a physical
# device or the iOS simulator, copy this to `.env` and use your LAN address.
#
# One Nest process serves both the API and the socket locally, so the two
# origins are the same here -- they only diverge where they are deployed apart.
TAJEER_ENV=development
TAJEER_API_URL=http://10.0.2.2:4040
TAJEER_SOCKET_URL=http://10.0.2.2:4040
