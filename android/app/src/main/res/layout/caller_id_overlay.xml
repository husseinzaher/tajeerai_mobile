<?xml version="1.0" encoding="utf-8"?>
<!--
    The caller card, inflated into a WindowManager window rather than an
    activity. A root view's own margins are ignored by WindowManager, so the
    inset is padding on this transparent wrapper, and the card is the child.
    The direction is set in code from the app's locale, not the device's: an
    Arabic workspace on an English phone reads right to left.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/caller_overlay_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/caller_id_card_background"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Header: who is drawing this, the call's state, and the way out. -->
        <LinearLayout
            android:id="@+id/caller_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/caller_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/caller_id_brand_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/caller_id_brand"
                android:textAppearance="@style/CallerIdCaption"
                android:textColor="@color/caller_id_primary_foreground"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/caller_direction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/CallerIdCaption"
                android:textColor="@color/caller_id_text_muted" />

            <ImageButton
                android:id="@+id/caller_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/caller_id_close_background"
                android:contentDescription="@string/caller_id_close"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_caller_id_close" />
        </LinearLayout>

        <!-- Identity: avatar, name, number, type. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <TextView
                    android:id="@+id/caller_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/caller_id_avatar_background"
                    android:gravity="center"
                    android:textAppearance="@style/CallerIdTitle"
                    android:textColor="@color/caller_id_primary_foreground"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/caller_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/caller_id_avatar"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/caller_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:textColor="@color/caller_id_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- A number reads left to right in either language: laid out
                     in Arabic, "+966…" would render as "966…+". -->
                <TextView
                    android:id="@+id/caller_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/CallerIdBody"
                    android:textColor="@color/caller_id_text_muted"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/caller_business"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/caller_id_badge_background"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textAppearance="@style/CallerIdCaption"
                    android:textColor="@color/caller_id_primary_text"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Facts: note, last order, address. Each row hides when empty. -->
        <LinearLayout
            android:id="@+id/caller_facts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/caller_id_panel_background"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <include
                android:id="@+id/caller_fact_order"
                layout="@layout/caller_id_fact" />

            <include
                android:id="@+id/caller_fact_address"
                layout="@layout/caller_id_fact" />

            <include
                android:id="@+id/caller_fact_note"
                layout="@layout/caller_id_fact" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/caller_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- After the call: what happened, in one line with its glyph. -->
        <LinearLayout
            android:id="@+id/caller_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/caller_status_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_caller_id_call_missed" />

            <TextView
                android:id="@+id/caller_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/CallerIdBody"
                android:textColor="@color/caller_id_text_secondary" />
        </LinearLayout>

        <!-- After the call: what to do about it. Call back, message, and the
             contact - the three things a merchant does next, in that order. -->
        <LinearLayout
            android:id="@+id/caller_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/caller_action_call"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/caller_id_button_primary"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_caller_id_call" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:text="@string/caller_id_call_back"
                    android:textAppearance="@style/CallerIdBody"
                    android:textColor="@color/caller_id_primary_foreground"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/caller_action_message"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/caller_id_button_outline"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_caller_id_message" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:text="@string/caller_id_message"
                    android:textAppearance="@style/CallerIdBody"
                    android:textColor="@color/caller_id_text_primary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/caller_action_customer"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/caller_id_button_outline"
                android:contentDescription="@string/caller_id_open_customer"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_caller_id_person" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
