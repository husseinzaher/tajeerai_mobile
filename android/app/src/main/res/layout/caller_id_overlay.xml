<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caller_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/caller_id_card_background"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/caller_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/caller_id_avatar"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/caller_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CallerIdCaption"
            android:textColor="#676B73" />

        <TextView
            android:id="@+id/caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CallerIdTitle"
            android:textColor="#353535"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caller_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CallerIdBody"
            android:textColor="#676B73" />

        <TextView
            android:id="@+id/caller_business"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/CallerIdBody"
            android:textColor="#454545" />

        <LinearLayout
            android:id="@+id/caller_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
