# Production.
#
#     flutter build apk --release --dart-define-from-file=.env.production
#
# The API and the socket are separate hosts. Authentication still works across
# them: the session cookies the API sets are not sent to the socket host, but
# the client never depended on that -- it reads the access token out of the
# cookie jar and the handshake carries it as `auth.token`.
TAJEER_ENV=production
TAJEER_API_URL=https://api.tajeerai.com
TAJEER_SOCKET_URL=https://socket.tajeerai.com
TAJEER_GOOGLE_ANDROID_CLIENT_ID=387470381057-m556n2mg3overj37q8p4qkpsnl97gcab.apps.googleusercontent.com
