<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Release builds need these. Flutter's template declares INTERNET only in
         the debug and profile manifests, for hot reload, so without this line a
         release build reaches neither the API nor the socket. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Lets the socket wait for a network path before retrying. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Caller ID overlay card above other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Read-only device contacts for local identification. Never WRITE_CONTACTS. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- No backups and no device-to-device transfer: the database holds a
         workspace's customers and messages, and secure storage holds session
         tokens. A copy restored onto another phone would be someone else's data
         under a session that phone never signed in to. -->
    <application
        android:label="TajeerAi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                Blog links from the web.

                `autoVerify` asks Android to check
                `https://tajeerai.com/.well-known/assetlinks.json` at install
                time and, if this app's signing certificate is listed there,
                open these links without ever asking the reader. Unverified,
                the same filter still works but Android shows a chooser - so a
                missing or wrong assetlinks file degrades to a worse experience
                rather than a broken one.

                Scoped to `/blog` by path prefix, not to the whole host: this
                app has no opinion about the pricing page, and claiming it
                would take that link away from the browser for nothing.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="tajeerai.com" android:pathPrefix="/blog" />
                <data android:scheme="https" android:host="www.tajeerai.com" android:pathPrefix="/blog" />
                <!-- The website prefixes its pages with a locale. -->
                <data android:scheme="https" android:host="tajeerai.com" android:pathPrefix="/ar/blog" />
                <data android:scheme="https" android:host="tajeerai.com" android:pathPrefix="/en/blog" />
                <data android:scheme="https" android:host="www.tajeerai.com" android:pathPrefix="/ar/blog" />
                <data android:scheme="https" android:host="www.tajeerai.com" android:pathPrefix="/en/blog" />
            </intent-filter>
            <!--
                The same destinations over the app's own scheme, for a link
                that does not need to survive being opened on a desktop -
                a push notification, or a campaign that knows the app is here.

                Host-qualified (`tajeerai://blog/...`), which is what keeps it
                out of the social sign-in callback's way below.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tajeerai" android:host="blog" />
            </intent-filter>
        </activity>
        <!--
            Where a social sign-in comes back to.

            The provider sends the browser to `tajeerai://auth/callback?code=…`
            and Android routes it here, which hands it to the Custom Tab this
            app opened. Nothing on that URL is secret: the code is worth
            nothing without the PKCE verifier the app kept and never sent, and
            any app may claim a custom scheme - which is exactly why the
            verifier exists. See the API's `SocialMobileHandoffUseCase`.

            `taskAffinity=""` on the package's own advice: without it the
            callback can land in a task of its own and the app appears twice in
            the recents list.
        -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <!--
                Scoped to the callback's own host.

                It used to claim `tajeerai://` with no host at all, which
                matched *every* address in this app's scheme - so a
                `tajeerai://blog/...` link would have been offered to this
                activity too and Android would have asked the reader which of
                two screens they meant. The callback has only ever been
                `tajeerai://auth/callback`, so naming that host is both
                narrower and more honest.
            -->
            <intent-filter android:label="tajeerai_social_callback">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tajeerai" android:host="auth" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <service
            android:name=".callerid.CallerIdCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="video/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="image/*"/>
        </intent>
        <!-- Lets native Google Sign-In see Play Services on Android 11+. -->
        <package android:name="com.google.android.gms" />
    </queries>
</manifest>
