<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ reads this instead of allowBackup for cloud backup and
  device-to-device transfer, so allowBackup="false" alone would still let a
  new phone copy the database and the session over. Nothing this app stores
  leaves the device that way: the database holds a workspace's customers and
  messages, and secure storage holds the session tokens.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
